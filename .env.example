# your EC2 public IP (sslip.io wildcard DNS = no DNS setup, Caddy auto-issues Let's Encrypt certs)
DOMAIN=YOUR_PUBLIC_IP.sslip.io
POSTGRES_PASSWORD=change-me-strong
BACKEND_SECRET=change-me-strong

# Alpaca paper trading (the final submission account, not a dev account)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true

# Cloudflare Workers AI - the trading brain's LLM backend (TradingAgents +
# options structuring), not this Cloudflare deploy's UI hosting
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Optional: set to a fixed comma-separated ticker list to skip the dynamic
# screener for that run. Leave unset (default) for dynamic ticker screening.
# WATCHLIST=SPY,QQQ,AAPL,MSFT,NVDA,AMZN
