# Meridian GraphQL schema - the ONLY browser-facing surface (raw fetch + graphql-ws).
# No auth: single-user hackathon demo, read-mostly dashboard over the
# trading agent's persisted decisions/trades/risk-gate log/account state.

type Leg {
  side: String!
  right: String!
  strike: Float!
  expiry: String!
  symbol: String!
  ratioQty: Int!
}

type Decision {
  id: ID!
  ticker: String!
  runDate: String!
  direction: String!
  confidence: Float!
  summary: String!
  fullReport: String!
  createdAt: String!
}

type Trade {
  id: ID!
  decisionId: String
  ticker: String!
  strategy: String!
  legs: [Leg!]!
  expiry: String!
  quantity: Int!
  creditDebit: String!
  netPremium: Float!
  maxProfit: Float!
  maxLoss: Float!
  status: String!
  alpacaOrderId: String
  realizedPnl: Float
  rationale: String
  openedAt: String
  closedAt: String
  createdAt: String!
}

type RiskGateEvent {
  id: ID!
  tradeId: String
  gateName: String!
  passed: Boolean!
  reason: String!
  createdAt: String!
}

type AccountSnapshot {
  id: ID!
  equity: Float!
  cash: Float!
  buyingPower: Float!
  optionsBuyingPower: Float
  dayPnl: Float
  openPositionsCount: Int!
  createdAt: String!
}

type Query {
  health: String!
  decisions(limit: Int = 50): [Decision!]!
  trades(status: String, limit: Int = 50): [Trade!]!
  riskGateEvents(limit: Int = 100): [RiskGateEvent!]!
  latestSnapshot: AccountSnapshot
  accountSnapshots(limit: Int = 100): [AccountSnapshot!]!
}

type Mutation {
  broadcast(message: String!): Boolean!   # local hub + gRPC Realtime.Broadcast
  runCycle(tickers: [String!]): String!   # -> Ai.RunCycle, returns cycle status
}

type Subscription {
  events: String!
}
